<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>The Post-Quantum Holy Grail</title>
  <link rel="icon" href="assets/favicon.svg" type="image/svg+xml">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    /* ---- page shell: matches edr-eval-walkthrough.html -------------------- */
    body {
      min-height: 100vh;
      color: #e8edf5;
      background-color: #101828;
      font-family: "SF Pro Display", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      font-size: 16pt;
      line-height: 1.5;
      position: relative;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: -25%;
      width: 150%;
      height: 150%;
      background: url("assets/backgrounds/earthrise.png") center center / cover no-repeat;
      transform: scale(1.4) rotate(22deg);
      transform-origin: center center;
      z-index: -2;
      pointer-events: none;
      opacity: 0.92;
    }

    body::after {
      content: "";
      position: fixed;
      inset: 0;
      background:
        linear-gradient(rgba(7, 11, 18, 0.16), rgba(7, 11, 18, 0.16)),
        radial-gradient(ellipse at 60% 30%, transparent 40%, rgba(10, 12, 20, 0.35) 100%);
      z-index: -1;
      pointer-events: none;
    }

    #star-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
      opacity: 0.5;
    }

    /* ---- layout: mobile first ------------------------------------------- */
    main {
      position: relative;
      z-index: 1;
      width: 100%;
      margin: 0 auto;
      padding: 20px 16px 44px;
    }

    .page-title {
      font-size: clamp(1rem, 4.4vw, 1.75rem);
      font-weight: 700;
      line-height: 1.3;
      color: #f8fafc;
      text-align: center;
      margin: 8px auto 22px;
      white-space: nowrap;
    }

    @media (min-width: 700px) {
      .page-title {
        font-size: 1.75rem;
        margin-bottom: 28px;
      }
    }

    @media (min-width: 700px) {
      main {
        width: 92%;
        max-width: 1000px;
        padding: 32px 0 64px;
      }
    }

    @media (min-width: 1280px) {
      main {
        max-width: 1120px;
      }
    }

    /* ---- intro cards: collapsible rows (white panels, teal accents) ------- */
    .intro-card {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 20px;
    }

    .intro-block {
      position: relative;
      overflow: hidden;
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    }

    .intro-head {
      list-style: none;
      cursor: pointer;
      padding: 14px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .intro-head::-webkit-details-marker {
      display: none;
    }

    .intro-kicker {
      font-size: 16pt;
      font-weight: 700;
      font-family: inherit;
    }

    .intro-block.problem .intro-kicker {
      color: #0284c7;
    }

    .intro-block.timeline .intro-kicker {
      color: #c2410c;
    }

    .intro-block.pqc .intro-kicker {
      color: #0f766e;
    }

    .intro-text {
      font-size: 16pt;
      color: #0f172a;
      line-height: 1.4;
      padding: 0 20px 18px;
    }

    .intro-text i {
      font-style: italic;
    }

    /* the checkmark is the toggle control */
    .intro-check {
      flex-shrink: 0;
      align-self: center;
      font-size: clamp(26px, 5.5vw, 48px);
      line-height: 1;
      font-weight: 700;
      color: #76b900;
      cursor: pointer;
      user-select: none;
      transition: opacity 0.15s ease;
    }

    .intro-head:hover .intro-check {
      opacity: 0.7;
    }

    .quiz-lead-in {
      font-size: 1.25rem;
      font-weight: 700;
      color: #f8fafc;
      text-align: center;
      margin: 4px auto 20px;
    }

    @media (min-width: 700px) {
      .quiz-lead-in {
        font-size: 1.4rem;
        margin-bottom: 24px;
      }
    }

    /* ====================================================================
       Quiz question + answer + feedback formatting (NVIDIA green & orange)
       ==================================================================== */
    .quiz-container {
      --bg-surface: #1b2740;
      --bg-surface-hover: #26365a;
      --border-color: #33456b;
      --text-primary: #f8fafc;
      --text-secondary: #a9b6cc;
      --accent-primary: #76b900;
      --accent-glow: rgba(118, 185, 0, 0.12);
      --accent-secondary: #ff6b00;
      --orange-glow: rgba(255, 107, 0, 0.12);
      --color-success: #76b900;
      --bg-success-glow: rgba(118, 185, 0, 0.08);
      --color-error: #ff3b30;
      --bg-error-glow: rgba(255, 59, 48, 0.1);
      --radius-lg: 14px;
      --radius-md: 10px;
      --transition-smooth: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);

      background-color: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 22px 18px;
      box-shadow: 0 25px 50px -20px rgba(0, 0, 0, 0.7);
      position: relative;
      color: var(--text-primary);
    }

    @media (min-width: 700px) {
      .quiz-container {
        padding: 36px;
      }
    }

    .quiz-container::before {
      content: '';
      position: absolute;
      top: -1px;
      left: 10%;
      width: 80%;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--accent-primary), var(--accent-secondary), transparent);
    }

    .quiz-header {
      margin-bottom: 32px;
    }

    .progress-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 14px;
      flex-wrap: wrap;
    }

    .category-badge {
      background-color: var(--accent-primary);
      color: #ffffff;
      border: 1px solid var(--accent-primary);
      padding: 5px 12px;
      border-radius: 6px;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .progress-text {
      font-size: 1rem;
      color: var(--text-secondary);
    }

    .progress-text strong {
      color: var(--accent-primary);
    }

    .progress-bar-container {
      background-color: var(--border-color);
      height: 5px;
      width: 100%;
      border-radius: 4px;
      overflow: hidden;
    }

    .progress-bar-fill {
      background: linear-gradient(90deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
      height: 100%;
      border-radius: 4px;
      transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .question-section {
      margin-bottom: 32px;
    }

    .question-text {
      font-size: 1.25rem;
      font-weight: 600;
      line-height: 1.45;
      color: var(--text-primary);
      letter-spacing: -0.01em;
    }

    @media (min-width: 700px) {
      .question-text {
        font-size: 1.4rem;
      }
    }

    .options-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      margin-bottom: 24px;
    }

    @media (min-width: 700px) {
      .options-grid {
        gap: 12px;
      }
    }

    .option-card {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 14px 16px;
      display: flex;
      align-items: center;
      text-align: left;
      cursor: pointer;
      transition: var(--transition-smooth);
      width: 100%;
      outline: none;
      font-family: inherit;
      color: var(--text-primary);
    }

    .option-card:not(:disabled):hover {
      background-color: var(--bg-surface-hover);
      border-color: var(--accent-primary);
      box-shadow: 0 0 15px var(--accent-glow);
    }

    .option-marker {
      background-color: var(--border-color);
      color: var(--text-secondary);
      width: 30px;
      height: 30px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 1rem;
      margin-right: 16px;
      flex-shrink: 0;
      transition: var(--transition-smooth);
    }

    .option-card:not(:disabled):hover .option-marker {
      background-color: var(--accent-primary);
      color: #000000;
    }

    .option-label {
      font-size: 15pt;
      font-weight: 500;
      color: var(--text-primary);
      flex-grow: 1;
      line-height: 1.4;
    }

    .status-icon {
      font-weight: 700;
      font-size: 1.1rem;
      margin-left: 12px;
    }

    .option-card.is-correct {
      background-color: var(--bg-success-glow);
      border-color: var(--color-success);
    }

    .option-card.is-correct .option-marker {
      background-color: var(--color-success);
      color: #000;
    }

    .option-card.is-correct .option-label {
      color: var(--color-success);
      font-weight: 600;
    }

    .option-card.is-correct .status-icon {
      color: var(--color-success);
    }

    .option-card.is-incorrect {
      background-color: var(--bg-error-glow);
      border-color: var(--color-error);
    }

    .option-card.is-incorrect .option-marker {
      background-color: var(--color-error);
      color: var(--text-primary);
    }

    .option-card.is-incorrect .option-label {
      color: var(--color-error);
      font-weight: 600;
    }

    .option-card.is-incorrect .status-icon {
      color: var(--color-error);
    }

    .option-card:disabled {
      cursor: not-allowed;
    }

    .option-card:disabled:not(.is-correct):not(.is-incorrect) {
      opacity: 0.35;
    }

    @media (min-width: 700px) {
      .option-card {
        padding: 16px 20px;
      }
    }

    .feedback-panel {
      display: none;
      background-color: #141d33;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 24px;
      margin-top: 24px;
      animation: slideIn 0.25s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    .feedback-panel.visible {
      display: block;
    }

    .feedback-badge {
      display: inline-block;
      font-size: 1rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 4px 10px;
      border-radius: 4px;
      margin-bottom: 14px;
    }

    .feedback-badge.success {
      background-color: var(--bg-success-glow);
      color: var(--accent-primary);
      border: 1px solid rgba(118, 185, 0, 0.2);
    }

    .feedback-badge.error {
      background-color: var(--bg-error-glow);
      color: var(--color-error);
      border: 1px solid rgba(255, 59, 48, 0.2);
    }

    .feedback-text {
      font-size: 15pt;
      line-height: 1.6;
      color: var(--text-secondary);
      margin-bottom: 20px;
    }

    .feedback-text p {
      margin-bottom: 12px;
    }

    .feedback-text p:last-of-type {
      margin-bottom: 0;
    }

    .feedback-text .k {
      display: inline-block;
      min-width: 92px;
      color: var(--accent-primary);
      font-weight: 700;
      vertical-align: top;
    }

    .feedback-text i {
      font-style: italic;
    }

    .status-chip {
      display: inline-block;
      margin-top: 12px;
      padding: 4px 10px;
      border-radius: 4px;
      font-size: 1rem;
      font-weight: 600;
      border: 1px solid;
    }

    .status-chip.done {
      color: var(--accent-primary);
      border-color: rgba(118, 185, 0, 0.35);
      background: var(--bg-success-glow);
    }

    .status-chip.partial {
      color: var(--accent-secondary);
      border-color: rgba(255, 107, 0, 0.35);
      background: var(--orange-glow);
    }

    .next-btn {
      background: linear-gradient(135deg, var(--accent-primary) 0%, #528200 100%);
      color: #000000;
      border: none;
      border-radius: var(--radius-md);
      padding: 14px 28px;
      font-size: 1rem;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      width: 100%;
      transition: var(--transition-smooth);
    }

    .next-btn:hover {
      box-shadow: 0 0 20px rgba(118, 185, 0, 0.35);
      transform: translateY(-1px);
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(8px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ---- results view (inside the quiz card) ----------------------------- */
    .results {
      display: none;
    }

    .results.visible {
      display: block;
    }

    .results h2 {
      font-size: 1.4rem;
      margin-bottom: 8px;
      color: var(--text-primary);
    }

    .results .summary {
      font-size: 1rem;
      color: var(--text-secondary);
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .score-cols {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 20px;
    }

    @media (min-width: 640px) {
      .score-cols {
        grid-template-columns: 1fr 1fr;
      }
    }

    .score-cols .col {
      background-color: #141d33;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 18px;
    }

    .score-cols h3 {
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 10px;
    }

    .score-cols .done h3 {
      color: var(--accent-primary);
    }

    .score-cols .not h3 {
      color: var(--accent-secondary);
    }

    .score-cols ul {
      list-style: none;
    }

    .score-cols li {
      font-size: 1rem;
      color: var(--text-secondary);
      line-height: 1.4;
      margin-bottom: 8px;
      padding-left: 16px;
      position: relative;
    }

    .score-cols li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 9px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
    }

    .score-cols .done li::before {
      background: var(--accent-primary);
    }

    .score-cols .not li::before {
      background: var(--accent-secondary);
    }

    .closing-note {
      font-size: 1rem;
      color: var(--text-secondary);
      line-height: 1.6;
      border-top: 1px solid var(--border-color);
      padding-top: 16px;
      margin-bottom: 20px;
    }

    .closing-note strong {
      color: var(--text-primary);
    }

    .closing-note i {
      font-style: italic;
    }

    /* ---- sources: edr-eval style (white code-box) ---------------------- */
    .code-box {
      margin-top: 20px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 4px;
      padding: 16px 20px;
      color: #0f172a;
      font-size: 16pt;
      line-height: 1.5;
    }

    .code-box h4 {
      margin-bottom: 10px;
      font-size: 16pt;
      font-family: inherit;
      color: #0f766e;
    }

    .code-box ol {
      padding-left: 22px;
    }

    .code-box li {
      margin-bottom: 6px;
      color: #334155;
    }

    .code-box i {
      font-style: italic;
    }
  </style>
</head>

<body>
  <canvas id="star-canvas"></canvas>

  <main>
    <h1 class="page-title">People with passion can change the world</h1>

    <div class="intro-card">
      <details class="intro-block problem" open>
        <summary class="intro-head">
          <span class="intro-kicker">The Problem</span>
          <span class="intro-check" aria-hidden="true">&#10003;</span>
        </summary>
        <div class="intro-text">In a "harvest now, decrypt later" (HNDL) attack, adversaries steal and store your
          encrypted data today, waiting for future quantum computers to decrypt the entire archive at once.</div>
      </details>
      <details class="intro-block timeline" open>
        <summary class="intro-head">
          <span class="intro-kicker">How long do we have?</span>
          <span class="intro-check" aria-hidden="true">&#10003;</span>
        </summary>
        <div class="intro-text">2030. Standard estimates span 2030 to 2040, see sources below.</div>
      </details>
      <details class="intro-block pqc" open>
        <summary class="intro-head">
          <span class="intro-kicker">PQC Alone Is Not Enough</span>
          <span class="intro-check" aria-hidden="true">&#10003;</span>
        </summary>
        <div class="intro-text">Post-quantum cryptography (PQC) relies on the same vulnerable structure: static
          ciphertext protected by a hard(er) math problem.</div>
      </details>
    </div>

    <p class="quiz-lead-in">Is Entropic Dispersal and Reassembly (EDR)&trade; a solution?<br> Find out by taking this
      short quiz</p>

    <div class="quiz-container">
      <div id="quiz-view">
        <div class="quiz-header">
          <div class="progress-meta">
            <span class="category-badge" id="cat">The Quantum threat</span>
            <span class="progress-text">Question <strong id="qn">1</strong> of 12 &nbsp;&middot;&nbsp; Score <strong
                id="sc">0</strong></span>
          </div>
          <div class="progress-bar-container">
            <div class="progress-bar-fill" id="bar" style="width:0"></div>
          </div>
        </div>

        <div class="question-section">
          <p class="question-text" id="qtext"></p>
        </div>

        <div class="options-grid" id="opts"></div>

        <div class="feedback-panel" id="fb">
          <span class="feedback-badge" id="fbbadge"></span>
          <div class="feedback-text" id="fbtext"></div>
          <button class="next-btn" id="next">Next</button>
        </div>
      </div>

      <div class="results" id="results-view">
        <h2 id="rtitle"></h2>
        <p class="summary" id="rsummary"></p>
        <div class="score-cols">
          <div class="col done">
            <h3>Demonstrated or basically complete</h3>
            <ul>
              <li>EDR: persistent plaintext and durable ciphertext exposure pushed as close to zero as operationally
                possible</li>
              <li>EDR: no conventional ciphertext object to harvest</li>
              <li>EDR: no master decryption key to steal</li>
              <li>EDR: no single stored particle reveals the data</li>
              <li>EDR: bit-perfect authorized reassembly</li>
              <li>EDR: hash and Merkle integrity verification</li>
              <li>EDR: transient, memory-only reassembly</li>
              <li>EDR: selective disclosure and reconstruction rate limiting</li>
              <li>EDR: provenance through anchors, commitments, hashes, evidence artifacts</li>
              <li>Mem<i>O</i>(1)&trade;: deterministic bit-perfect recall, verified by live SHA-256, million-turn
                benchmark</li>
              <li>Mem<i>O</i>(1)&trade;: token cost invariant to archive depth, flat addressable coordinate space</li>
              <li>Bounded per-turn context, near 278 tokens in the flagship run, 1,015,114 verified turns over 541+
                hours</li>
              <li>Local and edge operation on one workstation with an RTX 3050</li>
            </ul>
          </div>
          <div class="col not">
            <h3>Not claimed</h3>
            <ul>
              <li>A formal information-theoretic confidentiality proof</li>
              <li>Secure computation that never exposes the underlying data to the computation itself</li>
              <li>Formally proven quantum-independent security. Removing the ciphertext and key is promising, not a
                proof</li>
              <li>Security after every secret is known to the attacker. A different, much stronger threat model</li>
              <li>Mapped and tested compliance against PQC or regulatory standards</li>
              <li>Hardware-observed retrieval on real silicon. Pre-silicon has passed; KV260 board validation is next
              </li>
              <li>A mathematical impossibility proof for target recovery. Adversarial testing has recovered no target
                bytes so far, which is strong evidence, not a proof</li>
            </ul>
          </div>
        </div>
        <div class="closing-note">
          <p>EDR is <strong>Entropic Dispersal and Reassembly</strong>. It uses entropic dispersal, not encryption.
            Canonical claim: Entropic Dispersal is designed to push persistent plaintext and durable ciphertext exposure
            as close to zero as operationally possible.</p>
          <p>For a quantum-era threat model the point is that reassembly requires <strong>multi-party authorization, not
              computation</strong>. There is no conventional ciphertext to harvest and no master key to recover, so
            harvest now, decrypt later has nothing to act on. That is an argument, not a theorem. The architecture does
            not claim to be unbreakable; it claims to contain the blast radius of a breach.</p>
        </div>
        <button class="next-btn" id="restart">Start over</button>
      </div>
    </div>

    <div class="code-box">
      <h4>Sources</h4>
      <ol>
        <li>NIST, Post-Quantum Cryptography FIPS approved: FIPS 203 ML-KEM, 204 ML-DSA, 205 SLH-DSA, 13 Aug 2024. HQC
          selected as backup KEM, 11 Mar 2025.</li>
        <li>Palo Alto Networks, Keyfactor, The Quantum Insider: Harvest Now, Decrypt Later explainers, 2025 to 2026.
        </li>
        <li>Quantum resource estimates for RSA-2048 reduced from about 20M to under 1M qubits, papers May 2025 to Mar
          2026.</li>
        <li>NSA CNSA 2.0 FAQ. NSA, NCSC, and BSI positions declining to recommend QKD, citing no authentication,
          distance limits, and cost.</li>
        <li>Shamir, How to Share a Secret, 1979. Krawczyk, Secret Sharing Made Short, 1993. Resch and Plank, AONT-RS,
          USENIX FAST 2011.</li>
        <li>Homomorphic encryption overhead: roughly 2.5 s to encrypt 1 KB, 4.8 s per encrypted operation, about 5x
          ciphertext expansion. 2025 to 2026 surveys.</li>
        <li>TEE.Fail side-channel attack extracting secrets from Intel SGX and TDX and AMD SEV-SNP DDR5 enclaves with a
          sub-1000 dollar interposer, Oct 2025.</li>
        <li>EDR and Mem<i>O</i>(1)&trade; figures: internal benchmark and adversarial-test artifacts, including the
          million-turn run, 1,015,114 verified turns, and the attacker-only package.</li>
      </ol>
    </div>
  </main>

  <script>
    var Q = [
      {
        cat: "The threat",
        q: "An adversary copies your encrypted database today but cannot read it. Why is that already a serious problem?",
        options: [
          "It is not. Encrypted data is safe until the key leaks.",
          "They can store it and decrypt the whole archive later, once a quantum computer can break today's public-key encryption.",
          "Encryption slows their network, so they will give up before copying much."
        ],
        correct: 1,
        why: "This is harvest now, decrypt later. Public-key encryption like RSA and elliptic curve falls to Shor's algorithm on a large enough quantum computer. Recent work cut the estimated qubits to break RSA-2048 from about 20 million to under 1 million. Data captured now, with a shelf life past the early 2030s, is on the clock.",
        gap: "Classical encryption assumes the attacker cannot do the math. Harvesting removes the time pressure: the attacker just waits for the math to become doable.",
        edr: "Entropic Dispersal aims to leave no durable ciphertext object to copy, so there is nothing to stockpile against a future quantum computer.",
        status: ["done", "no ciphertext target to harvest, basically complete"]
      },
      {
        cat: "Post-quantum cryptography",
        q: "The new NIST post-quantum standards, ML-KEM and ML-DSA, are rolling out. Do they remove the harvest-now-decrypt-later risk for data you store?",
        options: [
          "Yes. Post-quantum encrypted data cannot be harvested.",
          "They replace the math, but you still store an encrypted blob that can be captured, still hold keys, and the new hardness is assumed, not proven.",
          "Yes, because post-quantum schemes delete data after it is read once."
        ],
        correct: 1,
        why: "PQC is necessary and worth deploying for data in transit going forward. FIPS 203, 204, and 205 were finalized in August 2024, with HQC added as a backup in March 2025. But PQC keeps the lock-and-key model.",
        gap: "There is still a ciphertext at rest to steal, still keys to manage, and lattice or code hardness is believed but not proven quantum-hard. The isogeny scheme SIKE was a NIST finalist for years, then was broken on a single laptop in 2022. Migration is a five to fifteen year project; harvested data is already gone.",
        edr: "EDR does not swap one math problem for another. Reassembly of dispersed particles requires multi-party authorization, not computation, so there is no ciphertext or key for a quantum computer to attack.",
        status: ["done", "no master decryption key, basically complete"]
      },
      {
        cat: "Plaintext at rest",
        q: "What is the strongest way to reduce what an attacker who images your disk can read?",
        options: [
          "Full-disk encryption with a strong passphrase.",
          "Store the records so the complete original is not written down anywhere in durable form.",
          "Rotate and delete logs on a short schedule."
        ],
        correct: 1,
        why: "If the complete original is not persisted, there is little on the disk image to read, with or without a key.",
        gap: "Full-disk and at-rest encryption still hold the plaintext whenever the volume is mounted, and the key lives on or near the same machine. A stolen running machine, a memory dump, or a leaked key exposes it.",
        edr: "Entropic Dispersal is designed to push persistent plaintext and durable ciphertext exposure as close to zero as operationally possible. It does not claim to eliminate exposure, it minimizes it.",
        status: ["done", "basically complete"]
      },
      {
        cat: "No ciphertext to harvest",
        q: "Harvesting works because there is a fixed encrypted object to copy and keep. What defeats that directly?",
        options: [
          "Encrypting twice with two different algorithms.",
          "Not persisting a conventional ciphertext object, so there is nothing whole to copy and stockpile.",
          "Changing the encryption key every hour."
        ],
        correct: 1,
        why: "Double encryption and frequent key rotation still leave a ciphertext object at rest. The archive still fills up; the attacker still just waits.",
        gap: "Every conventional scheme, classical or post-quantum, produces a ciphertext representation that can be captured as a unit and decrypted later.",
        edr: "EDR disperses data into particles in a high-entropy, non-ciphertext space. No single stored object represents the protected data in captured form.",
        status: ["done", "no ciphertext target to harvest, basically complete"]
      },
      {
        cat: "Dispersal",
        q: "Secret sharing and dispersed-storage systems split data into fragments. Is EDR the same thing under a different name?",
        options: [
          "Yes, it is the same mechanism with different branding.",
          "It is a related idea. Threshold secret sharing is quantum-safe if you hold fewer than the threshold, but classic schemes still rebuild to plaintext, expand storage several times over, and depend on keeping shares in truly independent domains.",
          "No, because secret sharing is broken by quantum computers."
        ],
        correct: 1,
        why: "Shamir secret sharing from 1979, and AONT plus dispersal schemes such as AONT-RS and Krawczyk's work, are real, respected, and not affected by Shor's algorithm, because their security rests on information theory, not number theory. Dispersal is a sound direction.",
        gap: "Classic threshold schemes reconstruct to full plaintext, multiply storage by the share count, and push the hard problem onto operations: the shares must live in domains that do not fail or get seized together.",
        edr: "EDR shatters data into particles reassembled via addressed keys, with reassembly gated by multi-party authorization. It is the blast-radius-containment architecture: a breach of the particle store yields inert noise. It does not claim a formal information-theoretic proof.",
        status: ["done", "no single stored object reveals data, basically complete"]
      },
      {
        cat: "Bit-perfect reassembly",
        q: "If data is dispersed into a high-entropy space, can the exact original be rebuilt with zero loss?",
        options: [
          "No. Any dispersal or transform loses some precision.",
          "Yes, when authorized. Reassembly returns the exact original, byte for byte, and it is verified.",
          "Only for text. Binary files cannot be rebuilt exactly."
        ],
        correct: 1,
        why: "Losing fidelity would make the approach useless for records, code, contracts, or evidence. The reassembly must be exact.",
        gap: "Lossy or approximate recall, as in vector search or summarization, is fine for search but not for anything that has to match the original.",
        edr: "EDR reassembly is a low-entropy, high-precision reconstruction of the dispersed history, and it is checked on the way out.",
        status: ["done", "demonstrated"]
      },
      {
        cat: "Integrity",
        q: "How do you know the data you got back was not altered while it was dispersed?",
        options: [
          "You cannot know. Dispersed fragments are unverifiable.",
          "Hash and Merkle verification over the reassembled result.",
          "A checksum embedded in the file name."
        ],
        correct: 1,
        why: "Particles could be corrupted or tampered with. Hashing the reassembled result and checking it against a committed Merkle structure catches any change.",
        gap: "Confidentiality and integrity are separate properties. Hiding data does not by itself prove it came back unchanged.",
        edr: "EDR uses hash and Merkle verification on reassembly.",
        status: ["done", "demonstrated"]
      },
      {
        cat: "Deterministic recall",
        q: "An AI system must recall an exact stored fact from a very large history. What does its memory layer need to provide?",
        options: [
          "A similarity search that returns the closest matching passages.",
          "The exact stored value, returned identically every time, verified against a stored hash.",
          "The entire history re-read into context on every turn."
        ],
        correct: 1,
        why: "Retrieval-augmented generation returns near matches, not the exact record. Re-reading the whole history is unbounded in cost and eventually impossible.",
        gap: "Approximate recall is acceptable for browsing. It is not acceptable when the agent must act on the exact value.",
        edr: "This is MemO(1), a separate product from EDR. It stores field values for a token and, on recall, recomputes SHA-256 live and compares it against the stored hash; verified is true only on a match. Its million-turn benchmark shows exact deterministic recall. No dispersal, no particles.",
        status: ["done", "demonstrated"]
      },
      {
        cat: "Addressed recall",
        q: "History grows to 1,000 days. What happens to the token cost of pulling a record from day 43?",
        options: [
          "It grows with the size of the history.",
          "It is the same as pulling a record from five minutes ago. Time is treated as a flat, addressable coordinate space.",
          "It becomes impossible past a few hundred days."
        ],
        correct: 1,
        why: "In the paradigms this replaces, reaching day 43 out of a 1,000-day history is effectively impossible. Treating logs as an addressable coordinate space makes retrieval cost invariant to archive depth.",
        gap: "Larger context windows raise the ceiling but do not change the shape of the curve. Cost still climbs with history.",
        edr: "The flagship run held active context near 278 tokens per turn across 1,015,114 verified turns and 541+ hours, on one workstation with an RTX 3050.",
        status: ["done", "demonstrated"]
      },
      {
        cat: "Transient reassembly",
        q: "When authorized data is rebuilt, where does the complete original live?",
        options: [
          "It is written back to disk so it can be reused quickly.",
          "It is materialized transiently in memory for use, then gone. The persistent store still holds no complete original.",
          "It is emailed to the requester as an attachment."
        ],
        correct: 1,
        why: "If reassembly persisted the plaintext, you would be back to plaintext at rest. Keeping the rebuilt original in memory only preserves the at-rest property.",
        gap: "Confidential computing and trusted execution environments also target data in use, but the plaintext sits inside an enclave, and enclaves keep falling to side-channel attacks. TEE.Fail, in October 2025, pulled secrets out of Intel SGX and TDX and AMD SEV-SNP with a device costing under 1000 dollars.",
        edr: "EDR reassembly is designed to materialize transiently rather than persist the target.",
        status: ["done", "basically complete"]
      },
      {
        cat: "Blast radius",
        q: "A valid credential is stolen, and separately an auditor needs three specific records out of millions. What should the system do?",
        options: [
          "Decrypt the whole dataset for the auditor, and treat the stolen credential as full access.",
          "Reassemble only the three records, and cap how much any credential can reconstruct over time so a theft leaks a trickle, not the vault.",
          "Have an AI write a summary instead of giving real records."
        ],
        correct: 1,
        why: "All-or-nothing decryption over-discloses to the auditor and gives a thief everything. Reassembly that targets specific records, plus a limit on reconstruction rate, bounds both.",
        gap: "Most encrypted stores are all-or-nothing once you are inside. A valid credential usually means the whole corpus.",
        edr: "EDR supports authorized reassembly of specific records and an extraction limiter on how much can be reconstructed. It does not claim to be unbreakable; it claims to contain the blast radius of a breach.",
        status: ["done", "basically complete"]
      },
      {
        cat: "The honest ceiling",
        q: "Which of these does EDR actually claim today?",
        options: [
          "A mathematical proof that target recovery from persistent state is impossible, and formally proven quantum-independent security.",
          "That plaintext and ciphertext exposure are pushed as close to zero as operationally possible, reassembly is bit-perfect and audited, and adversarial testing has so far recovered no target bytes. Strong evidence, not a proof.",
          "That EDR is already certified against post-quantum and regulatory standards."
        ],
        correct: 1,
        why: "The defensible claims are concrete: persistent plaintext and durable ciphertext exposure minimized as far as operationally possible; no master key; bit-perfect audited reassembly; deterministic recall at scale via MemO(1); and an adversarial package where no target bytes have been recovered to date.",
        gap: "The stronger claims are not made. There is no formal information-theoretic proof, no proven quantum-independent security, no secure-computation guarantee, and no mapped regulatory compliance. Hardware retrieval is proven pre-silicon; KV260 board validation is the next step.",
        edr: "Removing the ciphertext and the key means harvest now, decrypt later has nothing conventional to act on. That is a sound argument for the threat model, held to measured evidence rather than asserted as a theorem.",
        status: ["partial", "strong evidence and active hardware validation, not a formal proof"]
      }
    ];

    var idx = 0, score = 0, answered = false;
    var el = function (id) { return document.getElementById(id); };
    var quizView = el("quiz-view"), resultsView = el("results-view");
    var LETTERS = ["A", "B", "C", "D"];

    function esc(s) {
      return String(s).replace(/[&<>]/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c];
      });
    }
    // run after esc(): swap plain brand tokens for their intended markup
    function brand(s) {
      return s
        .replace(/MemO\(1s\)/g, "MemO(1<sub>s</sub>)")
        .replace(/MemO\(1\)/g, "Mem<i>O</i>(1)&trade;");
    }

    function render() {
      answered = false;
      var item = Q[idx];
      el("cat").textContent = item.cat;
      el("qn").textContent = String(idx + 1);
      el("sc").textContent = String(score);
      el("bar").style.width = (idx / Q.length * 100) + "%";
      el("qtext").textContent = item.q;

      var grid = el("opts");
      grid.innerHTML = "";
      item.options.forEach(function (text, i) {
        var b = document.createElement("button");
        b.className = "option-card";
        b.type = "button";
        b.innerHTML =
          "<span class='option-marker'>" + LETTERS[i] + "</span>" +
          "<span class='option-label'>" + esc(text) + "</span>" +
          "<span class='status-icon'></span>";
        b.addEventListener("click", function () { choose(i); });
        grid.appendChild(b);
      });

      el("fb").classList.remove("visible");
      el("next").textContent = (idx === Q.length - 1) ? "See results" : "Next";
    }

    function choose(i) {
      if (answered) return;
      answered = true;
      var item = Q[idx];
      var cards = el("opts").querySelectorAll(".option-card");
      cards.forEach(function (c, j) {
        c.disabled = true;
        var icon = c.querySelector(".status-icon");
        if (j === item.correct) { c.classList.add("is-correct"); icon.textContent = "✓"; }
        if (j === i && j !== item.correct) { c.classList.add("is-incorrect"); icon.textContent = "✗"; }
      });

      var isRight = (i === item.correct);
      if (isRight) score++;
      el("sc").textContent = String(score);

      var badge = el("fbbadge");
      badge.className = "feedback-badge " + (isRight ? "success" : "error");
      badge.textContent = isRight ? "Correct" : "Not quite";

      el("fbtext").innerHTML =
        "<p><span class='k'>Why</span> " + brand(esc(item.why)) + "</p>" +
        "<p><span class='k'>The gap</span> " + brand(esc(item.gap)) + "</p>" +
        "<p><span class='k'>EDR</span> " + brand(esc(item.edr)) + "</p>" +
        "<span class='status-chip " + item.status[0] + "'>" + esc(item.status[1]) + "</span>";

      el("fb").classList.add("visible");
      el("next").focus();
    }

    el("next").addEventListener("click", function () {
      if (!answered) return;
      if (idx < Q.length - 1) {
        idx++;
        render();
        document.querySelector(".quiz-container").scrollIntoView({ behavior: "smooth", block: "start" });
      } else {
        finish();
      }
    });

    function finish() {
      quizView.style.display = "none";
      resultsView.classList.add("visible");
      el("bar").style.width = "100%";
      el("rtitle").innerHTML = brand("Where EDR and MemO(1) stand");
      el("rsummary").textContent =
        "You answered " + score + " of " + Q.length + " correctly. The point is not the score. A real quantum-era solution has to satisfy every property above, and most tools satisfy only a few.";
      document.querySelector(".quiz-container").scrollIntoView({ behavior: "smooth", block: "start" });
    }

    el("restart").addEventListener("click", function () {
      idx = 0; score = 0;
      resultsView.classList.remove("visible");
      quizView.style.display = "block";
      render();
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    render();

    // Meteor canvas animation, forefront meteors only. From edr-eval-walkthrough.html.
    (function initMeteors() {
      var canvas = document.getElementById("star-canvas");
      if (!canvas) return;
      var ctx = canvas.getContext("2d");
      var w = (canvas.width = window.innerWidth);
      var h = (canvas.height = window.innerHeight);

      window.addEventListener("resize", function () {
        w = canvas.width = window.innerWidth;
        h = canvas.height = window.innerHeight;
      });

      var meteors = [];
      function createMeteor() {
        return {
          x: Math.random() * w * 1.2,
          y: Math.random() * (h * 0.4) - 100,
          length: Math.random() * 90 + 40,
          speed: Math.random() * 4 + 2.5,
          angle: Math.PI / 4,
          alpha: 0.45,
          width: Math.random() * 1.4 + 0.8
        };
      }

      for (var k = 0; k < 2; k++) {
        var m = createMeteor();
        m.y = Math.random() * h * 0.6;
        meteors.push(m);
      }

      function frame() {
        ctx.clearRect(0, 0, w, h);
        if (meteors.length < 3 && Math.random() < 0.01) meteors.push(createMeteor());
        for (var j = meteors.length - 1; j >= 0; j--) {
          var meteor = meteors[j];
          var tailX = meteor.x - Math.cos(meteor.angle) * meteor.length;
          var tailY = meteor.y - Math.sin(meteor.angle) * meteor.length;
          var grad = ctx.createLinearGradient(meteor.x, meteor.y, tailX, tailY);
          grad.addColorStop(0, "rgba(255, 255, 255, " + meteor.alpha + ")");
          grad.addColorStop(0.25, "rgba(140, 193, 193, " + (meteor.alpha * 0.85) + ")");
          grad.addColorStop(1, "rgba(140, 193, 193, 0)");
          ctx.strokeStyle = grad;
          ctx.lineWidth = meteor.width;
          ctx.lineCap = "round";
          ctx.beginPath();
          ctx.moveTo(meteor.x, meteor.y);
          ctx.lineTo(tailX, tailY);
          ctx.stroke();
          meteor.x += Math.cos(meteor.angle) * meteor.speed;
          meteor.y += Math.sin(meteor.angle) * meteor.speed;
          if (meteor.x > w + 200 || meteor.y > h + 200) meteors.splice(j, 1);
        }
        requestAnimationFrame(frame);
      }
      frame();
    })();
  </script>
</body>

</html>